{
  "name": "nlp-trading-bot-server",
  "version": "1.0.0",
  "description": "Backend service for NLP-Powered Crypto Trading Chatbot",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/test-validation.js && node test/test-db.js",
    "test:db": "node test/test-db.js",
    "test:api": "node test/test-api.js",
    "test:session": "node test/test-session.js",
    "test:nlp": "node test/test-transaction-nlp.js",
    "test:all": "node test/test-validation.js && node test/test-db.js && node test/test-transaction-nlp.js && node test/test-session.js",
    "create-wallet": "node src/createWallet.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
