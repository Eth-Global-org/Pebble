# Server Configuration
PORT=5001

# Blockchain / Testnet Settings (Sepolia)
# Set your Sepolia RPC endpoint (Infura, Alchemy, or PublicNode)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Burner Wallet Private Key (TESTNET ONLY - NEVER USE A MAINNET KEY WITH REAL FUNDS)
# Generated ephemeral test burner key by default
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Uniswap V2 Router Address on Sepolia
UNISWAP_V2_ROUTER_ADDRESS=0xC532a74256D3Db42D0Bf7a0400fEFDbad7694008

# Safety Rails and Operational Parameters
MAX_TRADE_SIZE_ETH=0.5
DEFAULT_SLIPPAGE_PERCENT=1.0
DEADLINE_MINUTES=10
PROPOSAL_TTL_SECONDS=120
PRICE_IMPACT_THRESHOLD_PERCENT=5.0

# Google Gemini AI Configuration (e.g. gemini-3-flash-preview, gemini-2.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Auto mock execution fallback if wallet has 0 testnet gas
ENABLE_DEMO_MOCK_FALLBACK=true
